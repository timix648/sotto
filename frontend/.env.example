# Sotto frontend. Copy to .env.local. NEVER put a private key in here —
# this file is bundled into the browser. Public config only.

# Live API against Hedera testnet .......... http://localhost:4000
# Fixture mock server (never film this) .... http://localhost:4010
NEXT_PUBLIC_API_BASE=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000/ws

# WalletConnect projectId from cloud.walletconnect.com.
# Optional: without it, MetaMask/injected still works. HashPack needs it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=858ac22fa8fbe6616a5a8022f78eabd3
