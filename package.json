{
  "name": "sotto",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "mock": "tsx backend/src/mock/server.ts",
    "build": "hardhat compile",
    "build:frontend": "npm run build --workspace @sotto/frontend",
    "dev:frontend": "npm run dev --workspace @sotto/frontend",
    "test": "hardhat test",
    "serve": "tsx backend/src/server.ts",
    "test:engine": "tsx --test backend/src/rfq/engine.test.ts",
    "test:frontend": "npm run test --workspace @sotto/frontend",
    "typecheck:frontend": "npm run typecheck --workspace @sotto/frontend",
    "test:batch": "tsx --test backend/src/chain/batch.test.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.0",
    "@hashgraph/sdk": "^2.81.0",
    "@openzeppelin/contracts": "^5.6.1",
    "ethers": "^6.17.0",
    "fastify": "^5.12.3",
    "viem": "^2.56.3"
  },
  "workspaces": [
    "packages/*",
    "backend",
    "frontend"
  ],
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@types/node": "^26.4.1",
    "hardhat": "^2.29.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
