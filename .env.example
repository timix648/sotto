# Sotto - Hedera testnet demo accounts
# Template - copy to .env and fill in
# NEVER COMMIT. NEVER SCREENSHOT. See docs/MECHANICS.md 4.11

HEDERA_NETWORK=testnet
JSON_RPC_URL=https://testnet.hashio.io/api
CHAIN_ID=296
USDC_TOKEN_ID=0.0.429274

# --- ISSUER ---
ISSUER_ADDRESS=0x...
ISSUER_PRIVATE_KEY=0x_your_key_here
ISSUER_ACCOUNT_ID=

# --- SELLER ---
SELLER_ADDRESS=0x...
SELLER_PRIVATE_KEY=0x_your_key_here
SELLER_ACCOUNT_ID=

# --- DEALER ---
DEALER_ADDRESS=0x...
DEALER_PRIVATE_KEY=0x_your_key_here
DEALER_ACCOUNT_ID=

