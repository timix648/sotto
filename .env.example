# Sotto - configuration template. Copy to .env and fill in the KEYS only.
# NEVER COMMIT .env. NEVER SCREENSHOT A KEY. See docs/MECHANICS.md 4.11.

HEDERA_NETWORK=testnet
JSON_RPC_URL=https://testnet.hashio.io/api
CHAIN_ID=296

# ---------------------------------------------------------------------------
# DEPLOYED CONTRACTS - public, already live on testnet. Do not redeploy these.
# All Sotto contracts are verified on Sourcify as exact_match.
# ---------------------------------------------------------------------------
BOND_ADDRESS=0xD53072649037FEecD305920087791a37dF8D517F
EQUITY_ADDRESS=0x21C3E7368a77756E896D58a6f97C3099Cc9C47e0
# short-dated note, for the redemption-at-maturity demo only
SHORT_BOND_ADDRESS=0x9c4e704b27dda83566d6f9ce0A2b1418b2249f14
SETTLEMENT_ADDRESS=0x73195C1f91899Bc1E822bb1D039033Eb38926931
NAV_ORACLE_ADDRESS=0xe8E7c39ba776C3B0778BE4571e72F5669f662c04
DEALER_BOND_ADDRESS=0xea7545EC3C5E74e0A44f8c289a657b6D849227E5
SCHEDULER_ADDRESS=0xe23f19786E146fADdBd6b3EEa9994e9feC0cf847
# Chainlink adapter behind SottoNavOracle's IPriceSource seam
PRICE_SOURCE_ADDRESS=0xFb321627eC70D7E86D82F80553dC2eC98BEb124a
HCS_TOPIC_ID=0.0.10383803

# Real Circle USDC on Hedera testnet, 6 decimals.
USDC_TOKEN_ID=0.0.429274
CASH_TOKEN_EVM=0x0000000000000000000000000000000000068cDa

# ---------------------------------------------------------------------------
# YOUR ACCOUNTS - fill these in. Three ECDSA keypairs.
#
#   1. Generate: node -e "const{ethers}=require('ethers');for(const r of ['ISSUER','SELLER','DEALER']){const w=ethers.Wallet.createRandom();console.log(r,w.address,w.privateKey)}"
#   2. Fund each address with HBAR from portal.hedera.com (this also CREATES the
#      account and gives you its 0.0.x id, which goes in *_ACCOUNT_ID).
#   3. Associate USDC BEFORE dripping it:
#         npx tsx backend/src/scripts/associate.ts
#      maxAutomaticTokenAssociations = -1 means "unlimited auto-association
#      SLOTS", NOT "pre-associated". The Circle faucet transfer does not qualify
#      for auto-association, so into an unassociated account the drip is
#      silently lost - no error, no pending airdrop - and it still burns the
#      faucet's 2-hour window.
#   4. Drip USDC at faucet.circle.com using the 0.0.x ACCOUNT IDs, not the 0x
#      addresses. 20 USDC per address per chain every 2 hours.
#
# NOTE: to trade the deployed bond your addresses need KYC granted on it, which
# only the original issuer key can do. Send your three addresses to the backend
# owner and ask them to run:  npx tsx backend/src/scripts/seed.ts
# ---------------------------------------------------------------------------
ISSUER_ADDRESS=0x...
ISSUER_PRIVATE_KEY=0x_your_key_here
ISSUER_ACCOUNT_ID=0.0.

SELLER_ADDRESS=0x...
SELLER_PRIVATE_KEY=0x_your_key_here
SELLER_ACCOUNT_ID=0.0.

DEALER_ADDRESS=0x...
DEALER_PRIVATE_KEY=0x_your_key_here
DEALER_ACCOUNT_ID=0.0.
